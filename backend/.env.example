# Application
PROJECT_NAME="Smart Expense Tracker API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="your-super-secret-key-for-jwt-do-not-use-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
ALGORITHM="HS256"

# Database
# Async PostgreSQL URL format
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker"

# CORS
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
