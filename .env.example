# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Production Environment Template
#
# Copy this file to .env in the project root and fill in all values marked
# REQUIRED before running docker compose in production.
#
# DO NOT commit a .env file with real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# ENVIRONMENT must be one of: development | staging | production | testing
ENVIRONMENT=production

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32

# Token lifetimes (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
# REQUIRED: Set credentials for your PostgreSQL instance
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Constructed DATABASE_URL (used by the backend service)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ── CORS ──────────────────────────────────────────────────────────────────────
# REQUIRED: Set to your actual frontend domain(s), comma-separated
# Example: https://app.yourcompany.com,https://www.yourcompany.com
BACKEND_CORS_ORIGINS=https://your-domain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Server ────────────────────────────────────────────────────────────────────
# Number of Gunicorn workers (default in gunicorn.conf.py: 2*CPU+1, max 8)
GUNICORN_WORKERS=3
GUNICORN_BIND=0.0.0.0:8000

# ── Port mapping (Docker Compose) ─────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Set to your Sentry project DSN to enable error reporting
# https://docs.sentry.io/product/sentry-basics/dsn-explainer/
SENTRY_DSN=
