# ─────────────────────────────────────────────────────────────────────────────
# Smart Expense Tracker — Backend Environment Variables
# Copy this file to .env and fill in all values before running the app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME="Smart Expense Tracker API"
# Superuser config
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=adminpassword

# Google OAuth Config
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FRONTEND_URL=http://localhost:3001
VERSION="1.0.0"
API_V1_STR="/api/v1"
# One of: development | staging | production | testing
ENVIRONMENT="development"

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-super-secret-key-for-jwt-do-not-use-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker"
ALEMBIC_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/expense_tracker"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL="INFO"

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Server (Gunicorn — production only) ───────────────────────────────────────
# Leave unset to use auto (2*CPU+1, max 8)
# GUNICORN_WORKERS=3
# GUNICORN_BIND="0.0.0.0:8000"

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# Set to your Sentry DSN to enable error reporting in production
# SENTRY_DSN="https://xxx@oyyy.ingest.sentry.io/zzz"

# ── AI Financial Assistant ──────────────────────────────────────────────────
# AI_PROVIDER can be: mock | openai | gemini | anthropic
AI_PROVIDER="mock"
# GEMINI_API_KEY="your-gemini-api-key-here"
